# ==============================================================================
# DocuMind - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Application Environment (development, staging, production, test)
DOCUMIND_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DOCUMIND_LOG_LEVEL=INFO

# Application Base Directories (relative paths resolve from project root)
DOCUMIND_DATA_DIR=data
DOCUMIND_STORAGE_DIR=data/storage
DOCUMIND_REPORTS_DIR=reports

# Document Ingestion Controls
DOCUMIND_MAX_UPLOAD_SIZE_MB=25
DOCUMIND_ALLOWED_MIME_TYPES=application/pdf

# OCR Configuration
# If Tesseract binary is not on system PATH, specify its executable path:
# e.g., on Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# e.g., on Linux: /usr/bin/tesseract
DOCUMIND_TESSERACT_CMD=
DOCUMIND_OCR_DEFAULT_LANG=eng
DOCUMIND_OCR_DPI=300

# Streamlit UI Configuration
DOCUMIND_APP_PORT=8501
DOCUMIND_APP_HOST=localhost
